cat > backend/auth.js <<'EOF'
const jwt = require('jsonwebtoken');
const db = require('./db');
const { v4: uuidv4 } = require('uuid');

const JWT_SECRET = process.env.JWT_SECRET || 'replace_with_a_strong_secret';
const ACCESS_EXPIRES_IN = process.env.ACCESS_EXPIRES_IN || '15m';
const REFRESH_EXPIRES_DAYS = parseInt(process.env.REFRESH_EXPIRES_DAYS || '30', 10);

function signAccessToken(user) {
  const payload = { id: user.id, name: user.name, email: user.email, role: user.role };
  return jwt.sign(payload, JWT_SECRET, { expiresIn: ACCESS_EXPIRES_IN });
}

function verifyAccessToken(token) {
  return jwt.verify(token, JWT_SECRET);
}

async function createRefreshToken(userId) {
  const token = uuidv4() + '.' + uuidv4();
  const expiresAt = new Date(Date.now() + REFRESH_EXPIRES_DAYS * 24 * 60 * 60 * 1000).toISOString();
  await db.query('INSERT INTO refresh_tokens (user_id, token, expires_at) VALUES ($1,$2,$3)', [userId, token, expiresAt]);
  return { token, expiresAt };
}

async function revokeRefreshToken(token) {
  await db.query('UPDATE refresh_tokens SET revoked=true WHERE token=$1', [token]);
}

async function validateRefreshToken(token) {
  const r = await db.query('SELECT id,user_id,revoked,expires_at FROM refresh_tokens WHERE token=$1', [token]);
  if (!r.rows.length) throw new Error('Invalid refresh token');
  const row = r.rows[0];
  if (row.revoked) throw new Error('Token revoked');
  if (new Date(row.expires_at) < new Date()) throw new Error('Token expired');
  return row;
}

module.exports = {
  signAccessToken,
  verifyAccessToken,
  createRefreshToken,
  revokeRefreshToken,
  validateRefreshToken
};
EOF

cat > backend/middleware/authMiddleware.js <<'EOF'
const db = require('../db');
const { verifyAccessToken } = require('../auth');

async function requireAuth(req, res, next) {
  const auth = req.headers.authorization;
  if (!auth || !auth.startsWith('Bearer ')) return res.status(401).json({ message: 'Missing token' });
  const token = auth.slice(7);
  try {
    const payload = verifyAccessToken(token);
    const r = await db.query('SELECT id,name,email,role FROM users WHERE id=$1', [payload.id]);
    if (!r.rows.length) return res.status(401).json({ message: 'User not found' });
    req.user = r.rows[0];
    next();
  } catch (err) {
    res.status(401).json({ message: 'Invalid token' });
  }
}

module.exports = { requireAuth };
EOF

cat > backend/middleware/rbac.js <<'EOF'
function requireRole(...allowedRoles) {
  return function (req, res, next) {
    if (!req.user) return res.status(401).json({ message: 'Not authenticated' });
    if (!allowedRoles.includes(req.user.role)) return res.status(403).json({ message: 'Forbidden' });
    next();
  };
}

module.exports = { requireRole };
EOF

cat > backend/s3.js <<'EOF'
const AWS = require('aws-sdk');

function createS3() {
  const s3 = new AWS.S3({
    accessKeyId: process.env.S3_ACCESS_KEY_ID,
    secretAccessKey: process.env.S3_SECRET_ACCESS_KEY,
    region: process.env.S3_REGION
  });
  return s3;
}

async function uploadToS3(buffer, key, mime) {
  const s3 = createS3();
  const params = {
    Bucket: process.env.S3_BUCKET,
    Key: key,
    Body: buffer,
    ContentType: mime,
    ACL: 'private'
  };
  const res = await s3.upload(params).promise();
  return res.Location;
}

module.exports = { uploadToS3 };
EOF

cat > backend/bin/wait-for-db.sh <<'EOF'
#!/usr/bin/env bash
set -e

hostport="$1"
timeout="${2:-30}"

IFS=':' read -r host port <<< "$hostport"

echo "Waiting for Postgres at $host:$port (timeout ${timeout}s)..."

start_ts=$(date +%s)
while true; do
  if pg_isready -h "$host" -p "$port" >/dev/null 2>&1; then
    echo "Postgres is ready"
    exit 0
  fi
  now_ts=$(date +%s)
  elapsed=$((now_ts - start_ts))
  if [ "$elapsed" -ge "$timeout" ]; then
    echo "Timed out waiting for Postgres"
    exit 1
  fi
  sleep 1
done
EOF

