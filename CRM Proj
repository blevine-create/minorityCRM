import React, { useEffect, useState } from 'react';
import API from '../api';

const STAGES = ['New','Contacted','Inspection','Proposal','Negotiation','Won','Lost'];

export default function Deals() {
  const [deals, setDeals] = useState([]);
  const [contacts, setContacts] = useState([]);
  const [form, setForm] = useState({ contact_id:'', title:'', estimated_value:0 });

  useEffect(() => { load(); }, []);

  function load() {
    API.get('/deals').then(r => setDeals(r.data)).catch(()=>{});
    API.get('/contacts').then(r => setContacts(r.data)).catch(()=>{});
  }

  function save(e) {
    e.preventDefault();
    API.post('/deals', form).then(()=> { setForm({ contact_id:'', title:'', estimated_value:0 }); load(); });
  }

  function move(dealId, stage) {
    API.put(`/deals/${dealId}`, { pipeline_stage: stage }).then(()=>load());
  }

  const grouped = STAGES.map(stage => ({ stage, items: deals.filter(d => d.pipeline_stage === stage) }));

  return (
    <div>
      <h2>Deals Pipeline</h2>

      <form onSubmit={save} style={{marginBottom:12}}>
        <select value={form.contact_id} onChange={e=>setForm({...form, contact_id:e.target.value})}>
          <option value="">Select contact</option>
          {contacts.map(c => <option key={c.id} value={c.id}>{c.first_name} {c.last_name}</option>)}
        </select>
        <input placeholder="Title" value={form.title} onChange={e=>setForm({...form, title:e.target.value})} />
        <input type="number" placeholder="Estimated value" value={form.estimated_value} onChange={e=>setForm({...form, estimated_value:parseFloat(e.target.value||0)})} />
        <button type="submit">Create Deal</button>
      </form>

      <div style={{display:'flex', gap:8, overflowX:'auto'}}>
        {grouped.map(g => (
          <div key={g.stage} style={{minWidth:180}}>
            <h4>{g.stage}</h4>
            {g.items.map(d => (
              <div key={d.id} className="card">
                <div><strong>{d.title}</strong></div>
                <div>Value: ${d.estimated_value}</div>
                <div>Stage: {d.pipeline_stage}</div>
                <div style={{marginTop:6}}>
                  {STAGES.filter(s => s !== d.pipeline_stage).map(s => (
                    <button key={s} onClick={()=>move(d.id,s)} style={{marginRight:6}}>{s}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  );
}
