const fs = require('fs');
const path = require('path');
const db = require('./db');

async function migrate() {
  const sql = fs.readFileSync(path.join(__dirname, 'migrations.sql'), 'utf8');
  try {
    await db.query(sql);
    // apply refresh migration if present
    const add = path.join(__dirname, 'migrations-add-refresh.sql');
    if (fs.existsSync(add)) {
      const sql2 = fs.readFileSync(add, 'utf8');
      await db.query(sql2);
    }
    console.log('Migrations applied');
    process.exit(0);
  } catch (err) {
    console.error('Migration error', err);
    process.exit(1);
  }
}

migrate();
EOF

