cat > backend/server.js <<'EOF'
require('dotenv').config();
const express = require('express');
const cors = require('cors');
const bcrypt = require('bcryptjs');
const { v4: uuidv4 } = require('uuid');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const AWS = require('aws-sdk');

const db = require('./db');
const {
  signAccessToken,
  createRefreshToken,
  revokeRefreshToken,
  validateRefreshToken
} = require('./auth');
const { requireAuth } = require('./middleware/authMiddleware');
const { requireRole } = require('./middleware/rbac');
const { uploadToS3 } = require('./s3');

const app = express();
const PORT = process.env.PORT || 4000;

app.use(cors());
app.use(express.json());

const UPLOAD_DIR = process.env.UPLOAD_DIR || path.join(__dirname, 'uploads');
if (!fs.existsSync(UPLOAD_DIR)) fs.mkdirSync(UPLOAD_DIR, { recursive: true });

const storage = multer.memoryStorage();
const upload = multer({ storage, limits: { fileSize: 10 * 1024 * 1024 } });

// Health
app.get('/api/health', async (req, res) => {
  try {
    await db.query('SELECT 1');
    res.json({ status: 'ok' });
  } catch (err) {
    res.status(500).json({ status: 'error', message: err.message });
  }
});

// Register
app.post('/api/register', async (req, res) => {
  const { name, email, password, role } = req.body;
  if (!name || !email || !password) return res.status(400).json({ message: 'Missing fields' });
  const existing = await db.query('SELECT id FROM users WHERE email=$1', [email]);
  if (existing.rows.length) return res.status(400).json({ message: 'Email already exists' });
  const hash = await bcrypt.hash(password, 10);
  const id = uuidv4();
  await db.query('INSERT INTO users (id,name,email,password_hash,role) VALUES ($1,$2,$3,$4,$5)', [id, name, email, hash, role || 'rep']);
  const user = { id, name, email, role: role || 'rep' };
  const accessToken = signAccessToken(user);
  const refresh = await createRefreshToken(user.id);
  res.json({ user, accessToken, refreshToken: refresh.token });
});

// Login
app.post('/api/login', async (req, res) => {
  const { email, password } = req.body;
  const r = await db.query('SELECT id,name,email,password_hash,role FROM users WHERE email=$1', [email]);
  if (!r.rows.length) return res.status(401).json({ message: 'Invalid credentials' });
  const user = r.rows[0];
  const ok = await bcrypt.compare(password, user.password_hash);
  if (!ok) return res.status(401).json({ message: 'Invalid credentials' });

  const accessToken = signAccessToken(user);
  const refresh = await createRefreshToken(user.id);
  res.json({ user: { id: user.id, name: user.name, email: user.email, role: user.role }, accessToken, refreshToken: refresh.token });
});

// Token refresh
app.post('/api/token/refresh', async (req, res) => {
  const { refreshToken } = req.body;
  if (!refreshToken) return res.status(400).json({ message: 'Missing refreshToken' });
  try {
    const row = await validateRefreshToken(refreshToken);
    const userRow = (await db.query('SELECT id,name,email,role FROM users WHERE id=$1', [row.user_id])).rows[0];
    if (!userRow) throw new Error('User not found');
    await revokeRefreshToken(refreshToken);
    const newRefresh = await createRefreshToken(userRow.id);
    const accessToken = signAccessToken(userRow);
    res.json({ accessToken, refreshToken: newRefresh.token });
  } catch (err) {
    res.status(401).json({ message: err.message || 'Invalid token' });
  }
});

// Logout
app.post('/api/logout', requireAuth, async (req, res) => {
  const { refreshToken } = req.body;
  if (refreshToken) {
    await revokeRefreshToken(refreshToken);
  }
  res.json({ message: 'Logged out' });
});

// Contacts
app.post('/api/contacts', requireAuth, async (req, res) => {
  const { first_name, last_name, phone, email, company_name, source, status } = req.body;
  const id = uuidv4();
  await db.query(\`INSERT INTO contacts (id,first_name,last_name,phone,email,company_name,source,status) VALUES ($1,$2,$3,$4,$5,$6,$7,$8)\`,
    [id, first_name, last_name, phone, email, company_name, source || 'unknown', status || 'lead']);
  const row = (await db.query('SELECT * FROM contacts WHERE id=$1', [id])).rows[0];
  res.status(201).json(row);
});

app.get('/api/contacts', requireAuth, async (req, res) => {
  const rows = (await db.query('SELECT * FROM contacts ORDER BY created_at DESC')).rows;
  res.json(rows);
});

// Deals
app.post('/api/deals', requireAuth, async (req, res) => {
  const { contact_id, title, pipeline_stage, estimated_value, close_date, assigned_user_id } = req.body;
  const id = uuidv4();
  await db.query(\`INSERT INTO deals (id,contact_id,title,pipeline_stage,estimated_value,close_date,assigned_user_id) VALUES ($1,$2,$3,$4,$5,$6,$7)\`,
    [id, contact_id, title, pipeline_stage || 'New', estimated_value || 0, close_date || null, assigned_user_id || null]);
  const row = (await db.query('SELECT * FROM deals WHERE id=$1', [id])).rows[0];
  res.status(201).json(row);
});

app.get('/api/deals', requireAuth, async (req, res) => {
  const rows = (await db.query('SELECT * FROM deals ORDER BY updated_at DESC')).rows;
  res.json(rows);
});

// Activities
app.post('/api/activities', requireAuth, async (req, res) => {
  const { deal_id, type, description, activity_date } = req.body;
  const id = uuidv4();
  await db.query(\`INSERT INTO activities (id,deal_id,type,description,activity_date,created_by_user_id) VALUES ($1,$2,$3,$4,$5,$6)\`,
    [id, deal_id, type || 'note', description, activity_date || new Date().toISOString(), req.user.id]);
  const row = (await db.query('SELECT * FROM activities WHERE id=$1', [id])).rows[0];
  res.status(201).json(row);
});

app.get('/api/activities', requireAuth, async (req, res) => {
  const rows = (await db.query('SELECT * FROM activities ORDER BY activity_date DESC')).rows;
  res.json(rows);
});

// Uploads (local or S3)
app.post('/api/uploads', requireAuth, upload.single('file'), async (req, res) => {
  if (!req.file) return res.status(400).json({ message: 'No file' });
  const id = uuidv4();
  const originalName = req.file.originalname;
  const mime = req.file.mimetype;
  const size = req.file.size;

  if (process.env.S3_ENABLED === 'true') {
    const key = \`uploads/\${id}-\${originalName}\`;
    try {
      const url = await uploadToS3(req.file.buffer, key, mime);
      await db.query('INSERT INTO uploads (id,filename,original_name,mime,size,url,uploaded_by) VALUES ($1,$2,$3,$4,$5,$6,$7)',
        [id, key, originalName, mime, size, url, req.user.id]);
      const row = (await db.query('SELECT * FROM uploads WHERE id=$1', [id])).rows[0];
      return res.status(201).json(row);
    } catch (err) {
      console.error('S3 upload error', err);
      return res.status(500).json({ message: 'Upload failed' });
    }
  } else {
    const filename = \`\${id}-\${originalName}\`;
    const filepath = path.join(UPLOAD_DIR, filename);
    fs.writeFileSync(filepath, req.file.buffer);
    const url = \`/uploads/\${filename}\`;
    await db.query('INSERT INTO uploads (id,filename,original_name,mime,size,url,uploaded_by) VALUES ($1,$2,$3,$4,$5,$6,$7)',
      [id, filename, originalName, mime, size, url, req.user.id]);
    const row = (await db.query('SELECT * FROM uploads WHERE id=$1', [id])).rows[0];
    res.status(201).json(row);
  }
});

// Presign for direct S3 upload
app.get('/api/uploads/presign', requireAuth, async (req, res) => {
  if (process.env.S3_ENABLED !== 'true') return res.status(400).json({ message: 'S3 not enabled' });

  const { filename, contentType } = req.query;
  if (!filename || !contentType) return res.status(400).json({ message: 'Missing filename or contentType' });

  const s3 = new AWS.S3({
    accessKeyId: process.env.S3_ACCESS_KEY_ID,
    secretAccessKey: process.env.S3_SECRET_ACCESS_KEY,
    region: process.env.S3_REGION
  });

  const key = \`uploads/\${Date.now()}-\${Math.random().toString(36).slice(2)}-\${filename}\`;

  const params = {
    Bucket: process.env.S3_BUCKET,
    Key: key,
    ContentType: contentType,
    ACL: 'private',
    Expires: 60
  };

  try {
    const url = await s3.getSignedUrlPromise('putObject', params);
    res.json({ url, key });
  } catch (err) {
    console.error('Presign error', err);
    res.status(500).json({ message: 'Presign failed' });
  }
});

// Record upload metadata after direct S3 upload
app.post('/api/uploads/record', requireAuth, async (req, res) => {
  const { key, originalName, mime, size } = req.body;
  if (!key) return res.status(400).json({ message: 'Missing key' });
  const id = uuidv4();
  const url = process.env.S3_ENABLED === 'true' ? \`s3://\${process.env.S3_BUCKET}/\${key}\` : \`/uploads/\${key}\`;
  await db.query('INSERT INTO uploads (id,filename,original_name,mime,size,url,uploaded_by) VALUES ($1,$2,$3,$4,$5,$6,$7)',
    [id, key, originalName || key, mime || null, size || 0, url, req.user.id]);
  const row = (await db.query('SELECT * FROM uploads WHERE id=$1', [id])).rows[0];
  res.status(201).json(row);
});

// Admin-only example
app.get('/api/admin/users', requireAuth, requireRole('admin'), async (req, res) => {
  const rows = (await db.query('SELECT id,name,email,role,created_at FROM users ORDER BY created_at DESC')).rows;
  res.json(rows);
});

// Dashboard
app.get('/api/dashboard', requireAuth, async (req, res) => {
  const totalContacts = (await db.query('SELECT COUNT(*) as c FROM contacts')).rows[0].c;
  const totalDeals = (await db.query('SELECT COUNT(*) as c FROM deals')).rows[0].c;
  const openDeals = (await db.query("SELECT COUNT(*) as c FROM deals WHERE pipeline_stage NOT IN ('Won','Lost')")).rows[0].c;
  const recentActivities = (await db.query('SELECT * FROM activities ORDER BY activity_date DESC LIMIT 20')).rows;
  res.json({ stats: { totalContacts, totalDeals, openDeals }, recentActivities });
});

app.use('/uploads', express.static(UPLOAD_DIR));

app.listen(PORT, () => {
  console.log(\`CRM backend running on http://localhost:\${PORT}\`);
});
